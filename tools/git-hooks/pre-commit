#!/bin/sh
# blake3-servil pre-commit hook: the performance-regression check (the
# working tree against HEAD, side by side), for commits that touch code.
# A confirmed regression (exit 1) aborts the commit; no verdict (exit 2:
# the machine's state changed during the check) warns and lets it through.
# `git commit --no-verify` skips the check after review.
#
# The check measures the working tree, which is what is being committed
# when the index holds all of it (git commit -a).
#
# Install: sh tools/install-git-hooks.sh (the VM's vm/setup.sh does it).
code=$(git diff --cached --name-only -- src c build.rs Cargo.toml Cargo.lock)
[ -z "$code" ] && exit 0
# PyPy where installed: the scripts use the standard library alone.
python=$(command -v pypy3 || command -v python3)
"$python" "$(git rev-parse --show-toplevel)/tools/perf_regress.py" check
case $? in
0) exit 0 ;;
2) echo "pre-commit: the performance check gave no verdict (above); committing. Check again on a quiet machine."; exit 0 ;;
*) echo "pre-commit: performance regression; commit aborted. After review, git commit --no-verify overrides."; exit 1 ;;
esac
