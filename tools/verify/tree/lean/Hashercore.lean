def final_node_loop.body
  {C : Type} {N : Type} {K : Type} (NodesInst : Nodes K C N) (k : K)
  (stack : CvStack) (n : Std.Usize) (out : N) :
  Result (ControlFlow (Std.Usize × N) N)
  := do
  if n > 0#usize
  then
    let n1 ← n - 1#usize
